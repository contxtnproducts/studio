---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { circled, inline } from "../../lib/format";

// The one story-detail layout (Figma "Desktop - 44", node 1679-3224):
// a centred reading measure flanked by a margin-note gutter each side,
// enclosed images inline, `full`/`bleed` images peeled into a stacked
// full-width "shots" section after the body. index.astro's story modal
// renders the same structure under its own `.story-modal__*` names.
// draft:true (the default — see content.config.ts) skips a story here
// entirely; every published one gets its route at /stories/<slug>/.
export async function getStaticPaths() {
  const entries = (
    await getCollection("work", (e) => !e.data.draft)
  ).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      nextSlug: entries[(i + 1) % entries.length].id,
    },
  }));
}

const { entry, nextSlug } = Astro.props;
const { title, summary, role, context, stage, tags, blocks } = entry.data;

const attributes = [
  ["Role", role],
  ["Context", context],
  ["Stage", stage],
  ["Tags", tags?.join(" , ")],
].filter(([, value]) => value);

// Group the running-text blocks into rows: each row is one body block
// (heading / paragraph / list / numbered / enclosed image) with an
// optional margin note. A `quote` block attaches as the note of the
// NEXT body block (it anchors to that row's top); a trailing quote
// rides on the last row. `full`/`bleed` images peel off into `shots`
// — their own stacked section after the body (Figma nodes 1679:3334-8).
const rows = [];
const shots = [];
{
  let pendingNote = null;
  for (const block of blocks) {
    if (block.type === "quote") {
      pendingNote = block;
      continue;
    }
    if (block.type === "image") {
      if (block.variant === "enclosed") {
        rows.push({ block, note: pendingNote });
        pendingNote = null;
      } else {
        shots.push(block);
      }
      continue;
    }
    rows.push({ block, note: pendingNote });
    pendingNote = null;
  }
  if (pendingNote && rows.length) rows[rows.length - 1].note = pendingNote;
}
---

<Base title={`${title} — poblete.design`} description={summary}>
  <div class="story">
    <!-- Margin strip + peek band + action rail — .strip/.strip::after
         /.punch are global (Base.astro). Punch-hole offsets follow
         Figma "Desktop - 44" (y 82 / 502 / 922). -->
    <div class="strip" aria-hidden="true">
      <img class="punch" style="--t:82px" src="/shots/hole.png" alt="" />
      <img class="punch" style="--t:502px" src="/shots/hole.png" alt="" />
      <img class="punch" style="--t:922px" src="/shots/hole.png" alt="" />
    </div>

    <div class="story-peek" aria-hidden="true"></div>

    <nav class="story-actions" aria-label="Story navigation">
      <a class="story-actions__btn" href={`/stories/${nextSlug}/`} aria-label="Next story">
        <svg class="story-actions__icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <path d="M8.33333 20H31.6667" />
          <path d="M20 8.33333L31.6667 20L20 31.6667" />
        </svg>
        <span class="story-actions__tip">Next story [<span class="story-actions__glyph">&rarr;</span>]</span>
      </a>
      <button type="button" class="story-actions__btn" id="story-detail-copy" aria-label="Copy link to this story">
        <svg class="story-actions__icon story-actions__icon--link" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
          <path d="M15 19.5C15.6442 20.3612 16.466 21.0738 17.4098 21.5894C18.3536 22.105 19.3973 22.4117 20.47 22.4885C21.5427 22.5653 22.6194 22.4106 23.627 22.0347C24.6347 21.6588 25.5497 21.0706 26.31 20.31L30.81 15.81C32.1762 14.3955 32.9321 12.501 32.9151 10.5345C32.898 8.56801 32.1092 6.68692 30.7186 5.29636C29.3281 3.9058 27.447 3.11703 25.4805 3.09994C23.514 3.08286 21.6195 3.83881 20.205 5.205L17.625 7.77" />
          <path d="M21 16.5C20.3558 15.6388 19.534 14.9262 18.5902 14.4106C17.6464 13.895 16.6027 13.5883 15.53 13.5115C14.4573 13.4347 13.3806 13.5894 12.373 13.9653C11.3653 14.3412 10.4503 14.9294 9.69 15.69L5.19 20.19C3.82381 21.6045 3.06786 23.499 3.08494 25.4655C3.10203 27.432 3.8908 29.3131 5.28136 30.7036C6.67192 32.0942 8.55301 32.883 10.5195 32.9001C12.486 32.9171 14.3805 32.1612 15.795 30.795L18.36 28.23" />
        </svg>
        <span class="story-actions__tip" id="story-detail-copy-tip">Copy link [L]</span>
      </button>
      <a class="story-actions__btn" href="/" aria-label="Close">
        <svg class="story-actions__icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <path d="M30 10L10 30" />
          <path d="M10 10L30 30" />
        </svg>
        <span class="story-actions__tip">Close [Esc]</span>
      </a>
    </nav>

    <article class="story__content">
      <!-- Hero — Figma node 1679:3274. pt-88 / px-72 / pb-72 inside the
           content column, hairline Grey 1 divider below; the title's own
           padding-bottom sets the gap to the attributes. -->
      <header class="story__hero">
        <div class="story__h1">
          <h1 class="story__title">{title}</h1>
        </div>

        {attributes.length > 0 && (
          <dl class="story__attrs">
            {attributes.map(([label, value]) => (
              <div class="story__attr">
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        )}
      </header>

      {rows.length > 0 && (
        <!-- Body section — node 1679:3292. Centred 477px measure + a
             235px margin-note gutter each side (57px clear); notes are
             absolutely placed and anchor to the top of their row. -->
        <section class="story__section">
          <div class="story__section-body">
            {rows.map((row) => (
              <div class={`story__row story__row--${row.block.type}`}>
                {row.note && (
                  <p class={`story__note story__note--${row.note.side}`}>{row.note.text}</p>
                )}
                {row.block.type === "heading" && (
                  <p class="story__heading">{row.block.text}</p>
                )}
                {row.block.type === "paragraph" && (
                  <p class="story__paragraph" set:html={inline(row.block.text)} />
                )}
                {row.block.type === "list" && (
                  <div class="story__list">
                    {row.block.items.map((item) => (
                      <p set:html={`→ ${inline(item)}`} />
                    ))}
                  </div>
                )}
                {row.block.type === "numbered" && (
                  <div class="story__list">
                    {row.block.items.map((item, j) => (
                      <p set:html={`${circled(j + 1)} ${inline(item)}`} />
                    ))}
                  </div>
                )}
                {row.block.type === "image" && (
                  <figure
                    class="story__image"
                    style={row.block.width ? `--img-width:${row.block.width}%` : undefined}
                  >
                    <img src={row.block.src} alt={row.block.alt} loading="lazy" />
                    {row.block.caption && (
                      <figcaption class="story__image-caption">{row.block.caption}</figcaption>
                    )}
                  </figure>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      {shots.length > 0 && (
        <!-- Screenshots — nodes 1679:3334-8. Full-width, inset 72px each
             side, native 16:9, a standard gap between consecutive ones.
             The mat + rounded card + shadow are baked into each PNG. -->
        <section class="story__shots">
          {shots.map((shot) => (
            <figure class="story__shot">
              <img src={shot.src} alt={shot.alt} loading="lazy" />
              {shot.caption && <figcaption class="story__shot-caption">{shot.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )}
    </article>
  </div>

  <!-- Shared cursor-anchored caption card for enclosed images + shots.
       Lives outside .story so no transformed ancestor breaks its
       position: fixed. Populated + moved by the script below; a static
       caption under each image takes over on touch / narrow. -->
  <p class="shot-tip" aria-hidden="true"></p>

  <script>
    // Copy-link + Esc/L keys.
    (function () {
      const btn = document.getElementById("story-detail-copy");
      const tip = document.getElementById("story-detail-copy-tip");
      if (!btn || !tip) return;
      const defaultLabel = tip.textContent;
      let timer;
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(location.href);
          tip.textContent = "Copied ✓";
        } catch {
          tip.textContent = "Copy failed";
        }
        clearTimeout(timer);
        timer = setTimeout(() => {
          tip.textContent = defaultLabel;
        }, 2200);
      });

      document.addEventListener("keydown", (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        if (e.key === "l" || e.key === "L") btn.click();
        else if (e.key === "Escape") {
          const close = document.querySelector('.story-actions__btn[aria-label="Close"]');
          if (close instanceof HTMLAnchorElement) close.click();
        }
      });
    })();

    // Image captions — text that tracks the cursor while a mouse hovers
    // an enclosed image or a full-width shot. Touch / narrow gets a
    // static caption under the image instead (see .story__image-caption
    // / .story__shot-caption in the media query). Show/hide are delayed
    // so a quick pass-through, or crossing the seam between two stacked
    // shots, doesn't make it flicker.
    (function () {
      const tip = document.querySelector(".shot-tip");
      const figures = document.querySelectorAll(".story__image, .story__shot");
      if (!tip || !figures.length) return;
      const GAP = 16, SHOW_DELAY = 140, HIDE_DELAY = 260;
      let lx = 0, ly = 0, raf = 0, showT = 0, hideT = 0;
      const place = () => {
        raf = 0;
        const w = tip.offsetWidth, h = tip.offsetHeight;
        let x = lx + GAP, y = ly + GAP;
        if (x + w > window.innerWidth - 12) x = lx - GAP - w;
        if (y + h > window.innerHeight - 12) y = ly - GAP - h;
        tip.style.setProperty("--tip-x", x + "px");
        tip.style.setProperty("--tip-y", y + "px");
      };
      const track = (e) => {
        lx = e.clientX;
        ly = e.clientY;
        if (!raf) raf = requestAnimationFrame(place);
      };
      const requestShow = (cap) => {
        clearTimeout(hideT);
        if (tip.classList.contains("is-visible")) {
          tip.textContent = cap.textContent;
          return;
        }
        clearTimeout(showT);
        showT = setTimeout(() => {
          tip.textContent = cap.textContent;
          place();
          tip.classList.add("is-visible");
        }, SHOW_DELAY);
      };
      const requestHide = () => {
        clearTimeout(showT);
        hideT = setTimeout(() => tip.classList.remove("is-visible"), HIDE_DELAY);
      };
      figures.forEach((fig) => {
        const cap = fig.querySelector(".story__image-caption, .story__shot-caption");
        if (!cap) return;
        fig.addEventListener("pointerenter", (e) => {
          if (e.pointerType !== "mouse") return;
          track(e);
          requestShow(cap);
        });
        fig.addEventListener("pointermove", (e) => {
          if (e.pointerType === "mouse") track(e);
        });
        fig.addEventListener("pointerleave", requestHide);
      });
    })();
  </script>
</Base>

<style>
  .story {
    display: flex;
    align-items: stretch;
    min-height: 100vh;
  }

  /* --- Margin strip / peek / action rail ----------------------
     .strip/.strip::after/.punch are global (Base.astro). */
  .story-peek {
    position: fixed;
    top: 0;
    bottom: 0;
    left: var(--strip);
    width: var(--strip);
    background: rgba(255, 255, 255, 0.72);
    border-right: 1px solid var(--border);
    z-index: 1;
  }

  .story-actions {
    position: fixed;
    left: var(--strip);
    width: var(--strip);
    bottom: 24px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 27px;
  }
  .story-actions__btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--main);
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 150ms ease;
  }
  .story-actions__btn:hover,
  .story-actions__btn:focus-visible {
    opacity: 1;
  }
  .story-actions__icon {
    width: 40px;
    height: 40px;
    fill: none;
  }
  .story-actions__icon--link {
    width: 36px;
    height: 36px;
  }
  .story-actions__icon path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.667;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .story-actions__tip {
    position: absolute;
    left: calc(100% + 32px);
    top: 50%;
    white-space: nowrap;
    font-family: var(--face-mono);
    font-size: var(--size-mast);
    letter-spacing: var(--track-mast);
    color: var(--main);
    opacity: 0;
    pointer-events: none;
    transform: translate(-6px, -50%);
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .story-actions__glyph {
    display: inline-block;
    vertical-align: middle;
  }
  .story-actions__btn:hover .story-actions__tip,
  .story-actions__btn:focus-visible .story-actions__tip {
    opacity: 1;
    transform: translate(0, -50%);
  }

  /* --- Content column ---------------------------------------- */
  .story__content {
    flex: 1 1 0;
    min-width: 0;
    /* clears the relative strip (72) + the fixed peek band (another
       72) that overlays this column's left edge */
    padding-left: var(--strip);
  }

  /* --- Hero — node 1679:3274 -------------------------------- */
  .story__hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 88px var(--strip) 72px;
    border-bottom: 1px solid var(--grey-1);
  }
  .story__h1 {
    width: 100%;
    max-width: 752px;
    padding-bottom: 24px;
  }
  .story__title {
    font-family: var(--face-mono);
    font-weight: 400;
    font-size: var(--size-hero);
    line-height: var(--leading-hero);
    letter-spacing: var(--track-hero);
    color: var(--black);
  }

  .story__attrs {
    width: 100%;
    max-width: 752px;
    margin: 0; /* <dl> — Base's reset covers p/ul/ol, not dl */
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: var(--size-mast);
    line-height: var(--leading-mast);
    letter-spacing: var(--track-hero);
    color: var(--black);
  }
  .story__attr {
    display: flex;
    align-items: center;
    gap: var(--row-gap);
  }
  .story__attr dt {
    flex: none;
    width: 88px;
    font-family: var(--face-mono);
    font-weight: 600;
  }
  .story__attr dd {
    margin: 0;
    font-family: var(--face-mono);
    font-weight: 400;
  }

  /* --- Body section — node 1679:3292 ------------------------------
     A 235px margin-note gutter, a 477px reading measure, another 235px
     gutter, 57px between them. Only the measure is in normal flow
     (centred in the section); each note is absolutely placed into a
     gutter, anchored to the top of its row. */
  .story__section {
    --note-w: 235px;
    --note-gap: 57px;
    --measure: 477px;
    padding: 72px var(--strip);
    border-bottom: 1px solid var(--grey-1);
  }
  .story__section-body {
    max-width: var(--measure);
    margin: 0 auto;
  }

  .story__row {
    position: relative;
  }
  /* Vertical rhythm (Figma): 24px between blocks, 16px within a run of
     paragraphs / before a list, 56px of breathing before a heading,
     32px around an image. */
  .story__row + .story__row { margin-top: 24px; }
  .story__row--paragraph + .story__row--paragraph,
  .story__row--paragraph + .story__row--list,
  .story__row--paragraph + .story__row--numbered { margin-top: 16px; }
  .story__row + .story__row--heading { margin-top: 56px; }
  .story__row + .story__row--image { margin-top: 32px; }
  .story__row--image + .story__row { margin-top: 32px; }
  .story__section-body > .story__row:first-child { margin-top: 0; }

  .story__heading {
    font-family: var(--face-mono);
    font-size: 21px;
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--main);
  }
  .story__paragraph {
    font-family: var(--face-sans);
    font-size: 18px;
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: #333;
  }
  .story__list {
    font-family: var(--face-sans);
    font-size: 18px;
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--black);
  }
  /* One <p> per item — a paragraph-sized gap between them. */
  .story__list p + p {
    margin-top: 16px;
  }
  /* :global — <strong>/<a> here come from inline() via set:html, so
     they carry no scoped-style attribute of their own. */
  .story__paragraph :global(strong),
  .story__list :global(strong) {
    font-weight: 500;
  }
  .story__paragraph :global(a),
  .story__list :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Enclosed image — inline in the measure, cropped to a consistent
     ratio regardless of source dimensions. */
  .story__image {
    /* --img-width is set inline per-block (see width in
       content.config.ts); default 100% keeps it flush with the
       measure. Negative margin centers any overhang evenly. */
    --img-width: 100%;
    width: var(--img-width);
    margin-left: calc((100% - var(--img-width)) / 2);
  }
  .story__image img {
    display: block;
    width: 100%;
    aspect-ratio: 1840 / 1035;
    height: auto;
    object-fit: cover;
    border-radius: 8px;
  }
  /* Desktop: the caption rides in the cursor-tracking .shot-tip on
     hover (see the script + .shot-tip rule); this element is just its
     data source. It comes back as a static caption under the image in
     the narrow layout. */
  .story__image-caption {
    display: none;
  }

  /* Margin notes — flush-right in the left gutter, flush-left in the
     right gutter, both 57px clear of the measure. */
  .story__note {
    position: absolute;
    /* Nudge down so the note's first-line baseline sits on the body
       text's first baseline: the 14px/1.5 note and the 18px/1.5 body
       have different first-baseline offsets (~4.5px apart). */
    top: 4px;
    width: var(--note-w);
    margin: 0;
    font-family: var(--face-mono);
    font-style: italic;
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--black);
  }
  .story__note--left {
    right: calc(100% + var(--note-gap));
    text-align: right;
  }
  .story__note--right {
    left: calc(100% + var(--note-gap));
  }

  /* --- Screenshots — nodes 1679:3334-8 --------------------------
     Full-width, inset 72px each side, native 16:9, a standard gap
     between consecutive ones. The mat / rounded card / shadow are
     part of each PNG. */
  .story__shots {
    padding: 72px var(--strip) 96px;
  }
  .story__shot {
    margin: 0;
  }
  .story__shot + .story__shot {
    margin-top: 32px;
  }
  .story__shot img {
    display: block;
    width: 100%;
    aspect-ratio: 2048 / 1152;
    height: auto;
    object-fit: cover;
  }
  /* Desktop: the caption rides in the cursor-tracking .shot-tip below;
     this element is just its data source. It comes back as a static
     caption under the image in the narrow layout. */
  .story__shot-caption {
    display: none;
  }
  /* Same treatment as the stories table's "Soon" caption
     (.table__soon in index.astro) and the action-rail tips — mono,
     black, no card; just wraps and clamps to the viewport since it's a
     sentence, not a word. */
  .shot-tip {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 60;
    max-width: 300px;
    margin: 0;
    font-family: var(--face-mono);
    font-size: var(--size-caption);
    line-height: var(--leading-mast);
    letter-spacing: var(--track-mast);
    color: var(--black);
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease;
    transform: translate3d(var(--tip-x, 0), var(--tip-y, 0), 0);
  }
  .shot-tip.is-visible {
    opacity: 1;
  }
  @media (hover: none) {
    .shot-tip { display: none; }
  }

  @media (max-width: 1024px) {
    .strip,
    .story-peek,
    .story-actions {
      display: none;
    }
    .story__content {
      padding-left: 0;
    }
    .story__hero {
      padding: 64px 32px 48px;
    }
    .story__section {
      padding: 48px 32px;
    }
    .story__section-body {
      max-width: 601px;
    }
    /* No gutter to bleed into once the margin notes fold into the
       flow — keep enclosed images flush with the measure. !important
       because --img-width is also set inline per-block. */
    .story__image {
      --img-width: 100% !important;
    }
    .story__shots {
      padding: 48px 32px 64px;
    }
    /* No cursor tooltips on touch / narrow — the caption returns as
       static text under each image. */
    .story__image-caption,
    .story__shot-caption {
      display: block;
      margin: 12px 0 0;
      font-family: var(--face-mono);
      font-size: var(--size-caption);
      line-height: var(--leading-mast);
      letter-spacing: var(--track-mast);
      color: var(--grey-3);
    }
    /* Gutters collapse — the note folds back into the flow as an
       indented aside just above the block it annotated. */
    .story__note {
      position: static;
      width: auto;
      max-width: 601px;
      margin: 0 0 16px;
      padding-left: 16px;
      border-left: 2px solid var(--main);
      text-align: left;
    }
  }
</style>
