  /* "Next" (see .testimonial__next) lives right after the quote span,
     inside the same <p> — a literal space in the markup between them
     separates it as its own word rather than running the two
     together. cursor/hover live on the parent .testimonial now
     (below), not here — the whole block, name included, is the click
     target for advancing the slider (see the script), not just the
     quote text. */
  .testimonial__quote {
    font-size: var(--size-mast);
    line-height: var(--leading-body);
    letter-spacing: -0.02em;
