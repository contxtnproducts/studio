  /* --- Testimonials ------------------------------------------------ */
  /* Name+quote as one <p> with a <br> between them, matching the Figma
     "Testimonials" node. A plain section now — the .sep above it is
     the rule that sets it off; 64px top/bottom padding, 72px sides,
     same as every other section. */
  .testimonials-section {
    padding: var(--section-y) var(--pad-x);
  }
  .testimonials {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
