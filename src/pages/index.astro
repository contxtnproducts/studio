  /* --- Narrow ----------------------------------------------------- */
  /* 1024px, not some arbitrary device size — the narrowest viewport
     where the stories table can render at its natural width without
     wrapping. Below it we drop straight to the single-column mobile
     layout, which already wraps table rows on purpose. (.side-rail
     has its own, wider 1152px breakpoint further up, for unrelated
     reasons — see the comment there — so it's already gone well
     before this one hits.) */
  @media (max-width: 1024px) {
    .strip { display: none; }
    /* Section side + top/bottom padding both follow their clamps
       (--pad-x / --section-y) — nothing to override here. */
    .masthead { gap: 12px; }
    .pill { white-space: normal; }
    .row { flex-direction: column; gap: 12px; }
    .row__label { width: auto; padding-top: 0; }
    .table__row { padding: 16px 0; }
    .navbar { gap: 20px; }
    /* [data-open="true"], not just .story-peek — the base rule sets
       display:block on that same attribute selector, which is more
       specific than a bare class and would otherwise win regardless
       of media query order. */
    .story-peek[data-open="true"] { display: none; }
    .story-modal { left: 0; }
    .story-modal__scroll { padding-top: 96px; padding-bottom: 40px; padding-left: 32px; padding-right: 48px; }
    /* .story-modal__scroll's own padding changed above (32/48 instead
       of strip/strip*1.5), so the breakout's re-added padding has to
       match: 100% + 32 + 48, same 100%-not-100vw reasoning as the
       base rules (see .story-modal__quote's own comment) — still true
       here even though .story-modal itself is left:0 at this width
       (so 100vw would happen to be close), no reason to reintroduce
       the ambiguity just because it'd be less wrong in this one case.
       Columns collapse to one: at 6 columns a 1-span cell would be a
       sixth of an already-narrow viewport, too small for a mockup
       screenshot to read — every cell stacks full width instead,
       ignoring its desktop --cell-col, so each mockup stays legible
       regardless of what fraction it was given on wide screens. */
    .story-modal__gallery {
      width: calc(100% + 32px + 48px);
      margin-left: -32px;
      padding-left: 32px;
      padding-right: 48px;
      grid-template-columns: 1fr;
    }
    .story-modal__cell { grid-column: 1; }
    /* Same breakout swap as the gallery above, same reason. */
    .story-modal__quote { width: calc(100% + 32px + 48px); margin-left: -32px; }
    .story-modal__quote-text { padding-left: 32px; padding-right: 48px; }
    .story-modal__image--full { width: calc(100% + 32px + 48px); margin-left: -32px; }
    /* The peek column it's normally pinned in is gone at this width
       (.story-peek above), so anchor to the viewport edge directly
       instead, with a 16px inset. */
    .story-actions { left: 16px; width: auto; }
