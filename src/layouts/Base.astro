---
export interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#ffffff" />

    <!-- Draft. Remove when you want Google to index it. -->
    <meta name="robots" content="noindex, nofollow" />

    <!-- Gates the scroll-reveal hidden state (see index.astro) behind
         confirmed JS support, so content just renders visible if JS
         never runs, instead of staying stuck invisible. -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spline+Sans+Mono:wght@400;700&family=Spline+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/tokens.css";

  *, *::before, *::after { box-sizing: border-box; }

  html {
    -webkit-text-size-adjust: 100%;
    /* A touch of breathing room above an anchor target (e.g. the hero's
       "Stories from the field" link → #stories) so it doesn't land
       flush against the viewport top. */
    scroll-padding-top: 24px;
  }
  /* Smooth in-page anchor jumps — only when the visitor hasn't asked
     for reduced motion. Applies to the document scroll only; the story
     modal has its own (instant) scroll container. */
  @media (prefers-reduced-motion: no-preference) {
    html { scroll-behavior: smooth; }
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--page-bg);
    color: var(--black);
    font-family: var(--face-sans);
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, p, ul, ol, figure { margin: 0; }
  ul, ol { padding: 0; list-style: none; }

  a { color: inherit; text-decoration: none; }

  /* --- Margin strip ------------------------------------------------
     Lives here (global, shared by every page through this layout)
     rather than duplicated per-page — index.astro and stories/[slug]
     both render the identical markup for it, so one shared stylesheet
     avoids keeping two copies in sync. */
  .strip {
    position: relative;
    flex: none;
    width: var(--strip);
    align-self: stretch;
    background: var(--strip-bg);
  }
  .strip::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 1px;
    background: var(--border);
  }
  .punch {
    position: absolute;
    left: 50%;
    top: var(--t);
    transform: translateX(-50%);
    width: 16px;
    height: 16px;
  }

  :focus-visible { outline: 2px solid var(--main); outline-offset: 3px; }

  ::selection { background: var(--main); color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
